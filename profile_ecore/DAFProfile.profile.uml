      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_RKlnUj0aEe6hwoNCJlhprA"/>
      <defaultValue xmi:type="uml:LiteralString" xmi:id="_RKlnUz0aEe6hwoNCJlhprA" value="config.ini"/>
    </ownedAttribute>
    <ownedAttribute xmi:id="_RKlnVD0aEe6hwoNCJlhprA" name="plattform">
