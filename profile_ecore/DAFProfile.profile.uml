  <packagedElement xmi:type="uml:Stereotype" xmi:id="_RKlnTj0aEe6hwoNCJlhprA" name="dSystem">
    <ownedComment xmi:id="_RKlnTz0aEe6hwoNCJlhprA">
      <body>A system configuration. Settings are modeled as attributes with default values</body>
    </ownedComment>
    <ownedAttribute xmi:id="_RKlnUD0aEe6hwoNCJlhprA" name="config">
      <ownedComment xmi:id="_RKlnUT0aEe6hwoNCJlhprA">
