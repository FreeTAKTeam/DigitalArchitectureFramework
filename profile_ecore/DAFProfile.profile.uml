    </ownedAttribute>
    <ownedAttribute xmi:id="_RKlnwj0aEe6hwoNCJlhprA" name="IncrementSupplyChain" type="_RKln9D0aEe6hwoNCJlhprA">
      <ownedComment xmi:id="_RKlnwz0aEe6hwoNCJlhprA">
        <body>The maturity level of your supply chain (Partners)</body>
