      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_RKlnqD0aEe6hwoNCJlhprA"/>
      <defaultValue xmi:type="uml:LiteralString" xmi:id="_RKlnqT0aEe6hwoNCJlhprA" value="Low"/>
