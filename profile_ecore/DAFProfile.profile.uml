  <packagedElement xmi:type="uml:Stereotype" xmi:id="_RKlnpD0aEe6hwoNCJlhprA" name="dCapability">
    <ownedComment xmi:id="_RKlnpT0aEe6hwoNCJlhprA">
      <body>A business outcome that is current available in an Organization Unit (or) A business-focused outcome that is delivered by the completion of one or more work packages.</body>
    </ownedComment>
    <ownedAttribute xmi:id="_RKlnpj0aEe6hwoNCJlhprA" name="BusinessValue" type="_RKln2T0aEe6hwoNCJlhprA">
      <ownedComment xmi:id="_RKlnpz0aEe6hwoNCJlhprA">
