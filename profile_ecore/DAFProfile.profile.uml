      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_RKlnAT0aEe6hwoNCJlhprA"/>
      <defaultValue xmi:type="uml:LiteralString" xmi:id="_RKlnAj0aEe6hwoNCJlhprA" value="50"/>
    </ownedAttribute>
    <ownedAttribute xmi:id="_RKlnAz0aEe6hwoNCJlhprA" name="ITSatisfaction">
