    <ownedAttribute xmi:id="_RKlnvj0aEe6hwoNCJlhprA" name="IncrementVertical" type="_RKln7T0aEe6hwoNCJlhprA">
      <ownedComment xmi:id="_RKlnvz0aEe6hwoNCJlhprA">
