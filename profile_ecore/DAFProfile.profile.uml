      </ownedComment>
      <ownedComment xmi:id="_RKlo2z0aEe6hwoNCJlhprA">
        <body>Could not find type for tagged value, using generic 'String' instead.</body>
      </ownedComment>
      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
