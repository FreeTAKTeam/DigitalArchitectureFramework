  <packagedElement xmi:type="uml:Stereotype" xmi:id="_RKmLVz0aEe6hwoNCJlhprA" name="dActionKey">
    <ownedComment xmi:id="_RKmLWD0aEe6hwoNCJlhprA">
      <body>Associates two ChiController instances (to define a control flow) or a ChiView with a ChiController (to define a view attachment), must be one directional</body>
    </ownedComment>
    <ownedAttribute xmi:id="_RKmLWT0aEe6hwoNCJlhprA" name="action">
      <ownedComment xmi:id="_RKmLWj0aEe6hwoNCJlhprA">
        <body>The action, which is triggered by this Dependency. If empty, any action is valid</body>
      </ownedComment>
      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_RKmLWz0aEe6hwoNCJlhprA"/>
    </ownedAttribute>
    <ownedAttribute xmi:id="_RKmLXD0aEe6hwoNCJlhprA" name="method">
      <ownedComment xmi:id="_RKmLXT0aEe6hwoNCJlhprA">
        <body>the operation name assigned to the target of this action key, if left empty the operation name will be equal to the action name.</body>
      </ownedComment>
      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_RKmLXj0aEe6hwoNCJlhprA"/>
    </ownedAttribute>
    <ownedAttribute xmi:id="_RKmLXz0aEe6hwoNCJlhprA" name="context">
      <ownedComment xmi:id="_RKmLYD0aEe6hwoNCJlhprA">
        <body>The context, in which this association is valid. If empty, any context is valid. e.g. when 2 controllers are linked twice</body>
      </ownedComment>
      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_RKmLYT0aEe6hwoNCJlhprA"/>
    </ownedAttribute>
    <ownedAttribute xmi:id="_RKmLYj0aEe6hwoNCJlhprA" name="config">
      <ownedComment xmi:id="_RKmLYz0aEe6hwoNCJlhprA">
        <body>The configuration, in which this association is defined</body>
      </ownedComment>
      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_RKmLZD0aEe6hwoNCJlhprA"/>
      <defaultValue xmi:type="uml:LiteralString" xmi:id="_RKmLZT0aEe6hwoNCJlhprA" value="config.ini"/>
    </ownedAttribute>
    <ownedAttribute xmi:id="_RKmLZj0aEe6hwoNCJlhprA" name="decorator">
      <ownedComment xmi:id="_RKmLZz0aEe6hwoNCJlhprA">
        <body>Allows to dynamically attach special behaviors to the result operation without changing his implementation . e.g. a decorator REST, will expose this endpoint as a REST service.</body>
      </ownedComment>
      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
