    <ownedAttribute xmi:id="_RKlntj0aEe6hwoNCJlhprA" name="Increments" type="_RKln3z0aEe6hwoNCJlhprA">
      <ownedComment xmi:id="_RKlntz0aEe6hwoNCJlhprA">
        <body>Current (AS-IS) maturity level for the entity. 
0- none
1- Initial
2- UnderDevelopment
3 - Defined
4- Managed
5 - Measured</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_RKlnuD0aEe6hwoNCJlhprA"/>
      <defaultValue xmi:type="uml:LiteralString" xmi:id="_RKlnuT0aEe6hwoNCJlhprA" value="None"/>
