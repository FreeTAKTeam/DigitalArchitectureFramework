      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_RKlnvD0aEe6hwoNCJlhprA"/>
      <defaultValue xmi:type="uml:LiteralString" xmi:id="_RKlnvT0aEe6hwoNCJlhprA" value="Initial"/>
