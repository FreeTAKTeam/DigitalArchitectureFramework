# Concept: Application Component
daf:dApplicationComponent
    a owl:Class, dafm:ConceptDefinition ;
    rdfs:label "Application Component" ;
    skos:notation "dApplicationComponent" ;
    dafm:eaGuid "{45B580EA-F838-41b6-BB80-D7B3DC2DDB9D}" ;
    dafm:definedInPackage dafpkg:Package_n_02BC7973 ;
    dafm:packagePath "Delta Architectural Framework/DAF/Metamodel" ;
    skos:altLabel "dApplicationComponent" ;
    rdfs:comment "An application component is a self-contained unit. As such, it is independently deployable, re-usable, and replaceable. An application component performs one or more application functions. It encapsulates its behavior and data, exposes services, and makes them available through interfaces. Cooperating application components are connected via application collaborations.\n\nAn application component may be assigned to one or more application functions. An application component has one or more application interfaces, which expose its functionality. Application interfaces of other application components may serve an application component. The name of an application component should preferably be a noun." ;
    dafm:umlMetaclass "Component" .

daf:dApplicationComponent rdfs:subClassOf daf:DAFBase .

dafshape:dApplicationComponentShape
    a sh:NodeShape ;
    sh:targetClass daf:dApplicationComponent ;
    sh:node dafshape:DAFBaseShape .

