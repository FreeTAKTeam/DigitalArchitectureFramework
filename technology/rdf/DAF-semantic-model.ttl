    a owl:DatatypeProperty ;
    rdfs:label "tag value" ;
    rdfs:comment "Original tagged-value value." ;
    rdfs:range xsd:string .

dafm:tagNotes
    a owl:DatatypeProperty ;
    rdfs:label "tag notes" ;
    rdfs:comment "Original tagged-value notes where available." ;
    rdfs:range xsd:string .

