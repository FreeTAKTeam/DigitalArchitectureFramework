<https://freetakteam.github.io/DAF/ontology>
    a owl:Ontology ;
    dcterms:title "DAF Semantic Metamodel" ;
    dcterms:description "Technology-independent RDF/OWL/SHACL representation generated from the authoritative DAF M3/M2 model." ;
    dcterms:created "2026-08-07T17:25:55"^^xsd:dateTime ;
    dafm:generatorVersion "1.5.0" ;
    dafm:sourcePackageGuid "{02BC7973-A0CB-4865-A42E-ECA442FF2D0D}" ;
    dafm:sourcePackageName "Metamodel" ;
    dafm:profileName "DAF" ;
    dafm:configuredProfilePackageGuid "{BEFFD7D1-82EE-478f-A0EE-5670EC836630}" ;
    dafm:configuredRelationshipPackageGuid "{C3097ACD-177F-4d58-B51F-771989DAFF70}" ;
    dafm:configuredProfileDiagramGuid "{B91435BE-4D2E-4511-8A96-481522342E3A}" .

# ---------------------------------------------------------------------
# DAF meta-metamodel vocabulary
# ---------------------------------------------------------------------

dafm:ModelElement
    a owl:Class ;
    rdfs:label "Model Element" ;
    rdfs:comment "Vendor-neutral base class for all DAF M1 model elements." .

dafm:Relationship
    a owl:Class ;
    rdfs:label "Relationship" ;
    rdfs:comment "First-class relationship instance with source, target and a relationship type." .

dafm:Relationship rdfs:subClassOf dafm:ModelElement .

dafm:ConceptDefinition
    a owl:Class ;
    rdfs:label "Concept Definition" ;
    rdfs:comment "M2 definition of a DAF modeling concept." .

dafm:PropertyDefinition
    a owl:Class ;
    rdfs:label "Property Definition" ;
    rdfs:comment "M2 definition of a semantic property originating from an M3 attribute." .

dafm:RelationshipType
    a owl:Class ;
    rdfs:label "Relationship Type" ;
    rdfs:comment "M2 first-class definition of a legal DAF relationship." .

dafm:RelationshipEnd
    a owl:Class ;
    rdfs:label "Relationship End" ;
    rdfs:comment "Definition of one end of a DAF relationship." .

dafm:Enumeration
    a owl:Class ;
    rdfs:label "Enumeration" ;
    rdfs:comment "M2 enumeration definition." .

dafm:EnumerationValue
    a owl:Class ;
    rdfs:label "Enumeration Value" ;
    rdfs:comment "A permitted value of an M2 enumeration." .

dafm:TaggedValue
    a owl:Class ;
    rdfs:label "Tagged Value" ;
    rdfs:comment "Source M3/EA tagged value preserved for traceability." .

dafm:Constraint
    a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "Constraint preserved from the source M3 model." .

dafm:PackageDefinition
    a owl:Class ;
    rdfs:label "Package Definition" ;
    rdfs:comment "Source metamodel package used to organize DAF concepts." .

dafm:SupportingClassDefinition
    a owl:Class ;
    rdfs:label "Supporting Class Definition" ;
    rdfs:comment "Class found in the M3 package that is not stereotyped as Concept." .

dafm:TypingStatus
    a owl:Class ;
    rdfs:label "Typing Status" ;
    rdfs:comment "Status describing how an M3 property datatype was resolved during semantic-model generation." .

dafm:OperationDefinition
    a owl:Class ;
    rdfs:label "Operation Definition" ;
    rdfs:comment "Operation/method definition preserved from the source M3 model." .

dafm:ParameterDefinition
    a owl:Class ;
    rdfs:label "Parameter Definition" ;
    rdfs:comment "Operation parameter definition preserved from the source M3 model." .

dafm:GenerationRecord
    a owl:Class ;
    rdfs:label "Generation Record" ;
    rdfs:comment "Metadata describing one generation of the semantic metamodel." .

dafm:GeneralizationDefinition
    a owl:Class ;
    rdfs:label "Generalization Definition" ;
    rdfs:comment "Source generalization preserved as both RDFS inheritance and an auditable M3 definition." .

dafm:AuthoringPolicy
    a owl:Class ;
    rdfs:label "Authoring Policy" ;
    rdfs:comment "Technology-independent policy describing how users and tools may create or connect instances of a DAF relationship type." .


dafm:source
    a owl:ObjectProperty ;
    rdfs:label "source" ;
    rdfs:comment "Source model element of a first-class relationship." .

dafm:target
    a owl:ObjectProperty ;
    rdfs:label "target" ;
    rdfs:comment "Target model element of a first-class relationship." .

dafm:relationshipType
    a owl:ObjectProperty ;
    rdfs:label "relationship type" ;
    rdfs:comment "Relationship type instantiated by a first-class relationship." .

dafm:sourceClass
    a owl:ObjectProperty ;
    rdfs:label "source class" ;
    rdfs:comment "Allowed semantic source class of a relationship type." .

dafm:targetClass
    a owl:ObjectProperty ;
    rdfs:label "target class" ;
    rdfs:comment "Allowed semantic target class of a relationship type." .

dafm:sourceEnd
    a owl:ObjectProperty ;
    rdfs:label "source end" ;
    rdfs:comment "Source-end definition." .

dafm:targetEnd
    a owl:ObjectProperty ;
    rdfs:label "target end" ;
    rdfs:comment "Target-end definition." .

dafm:projectionPredicate
    a owl:ObjectProperty ;
    rdfs:label "projection predicate" ;
    rdfs:comment "OWL/RDF object property used as the direct graph projection of a first-class relationship." .

dafm:inversePredicate
    a owl:ObjectProperty ;
    rdfs:label "inverse predicate" ;
    rdfs:comment "Inverse OWL/RDF projection predicate." .

dafm:definedInPackage
    a owl:ObjectProperty ;
    rdfs:label "defined in package" ;
    rdfs:comment "Source package containing this metamodel definition." .

dafm:hasPropertyDefinition
    a owl:ObjectProperty ;
    rdfs:label "has property definition" ;
    rdfs:comment "Links a concept definition to one of its M3 attribute/property definitions." .

dafm:hasTaggedValue
    a owl:ObjectProperty ;
    rdfs:label "has tagged value" ;
    rdfs:comment "Links a metamodel object to a preserved tagged value." .

dafm:hasConstraint
    a owl:ObjectProperty ;
    rdfs:label "has constraint" ;
    rdfs:comment "Links a metamodel object to a preserved constraint." .

dafm:enumeration
    a owl:ObjectProperty ;
    rdfs:label "enumeration" ;
    rdfs:comment "Enumeration constraining a property definition." .

dafm:parentPackage
    a owl:ObjectProperty ;
    rdfs:label "parent package" ;
    rdfs:comment "Parent source package." .

dafm:definedBy
    a owl:ObjectProperty ;
    rdfs:label "defined by" ;
    rdfs:comment "Links a property, operation or parameter definition to its defining metamodel object." .

dafm:endClass
    a owl:ObjectProperty ;
    rdfs:label "end class" ;
    rdfs:comment "Class associated with a relationship end." .

dafm:classifier
    a owl:ObjectProperty ;
    rdfs:label "classifier" ;
    rdfs:comment "Semantic classifier associated with an M3 attribute or parameter." .

dafm:sourceClassifier
    a owl:ObjectProperty ;
    rdfs:label "source classifier" ;
    rdfs:comment "Original Enterprise Architect classifier retained as source-model provenance when semantic typing overrides it." .

dafm:typingStatus
    a owl:ObjectProperty ;
    rdfs:label "typing status" ;
    rdfs:comment "How the datatype of an M3 property was resolved." .

dafm:authoringPolicy
    a owl:ObjectProperty ;
    rdfs:label "authoring policy" ;
    rdfs:comment "Authoring behavior associated with a DAF relationship type." .


dafm:eaGuid
    a owl:DatatypeProperty ;
    rdfs:label "EA GUID" ;
    rdfs:comment "Original Enterprise Architect GUID used for migration traceability." ;
    rdfs:range xsd:string .

dafm:umlMetaclass
    a owl:DatatypeProperty ;
    rdfs:label "UML metaclass" ;
    rdfs:comment "UML metaclass represented by a DAF concept or relationship." ;
    rdfs:range xsd:string .

dafm:redefines
    a owl:DatatypeProperty ;
    rdfs:label "redefines" ;
    rdfs:comment "External or internal stereotype redefined by the source M3 definition." ;
    rdfs:range xsd:string .

dafm:refines
    a owl:DatatypeProperty ;
    rdfs:label "refines" ;
    rdfs:comment "External semantic concept refined by the source M3 definition." ;
    rdfs:range xsd:string .

dafm:forwardRole
    a owl:DatatypeProperty ;
    rdfs:label "forward role" ;
    rdfs:comment "Forward semantic role/meaning from source to target." ;
    rdfs:range xsd:string .

dafm:backwardRole
    a owl:DatatypeProperty ;
    rdfs:label "backward role" ;
    rdfs:comment "Backward semantic role/meaning from target to source." ;
    rdfs:range xsd:string .

dafm:cardinality
    a owl:DatatypeProperty ;
    rdfs:label "cardinality" ;
    rdfs:comment "Cardinality text exactly as stored in the source model." ;
    rdfs:range xsd:string .

dafm:relationshipKind
    a owl:DatatypeProperty ;
    rdfs:label "relationship kind" ;
    rdfs:comment "UML/DAF relationship kind such as Association, Aggregation, Composition, Dependency, Generalization or Realization." ;
    rdfs:range xsd:string .

dafm:allowConnectExisting
    a owl:DatatypeProperty ;
    rdfs:label "allow connect existing" ;
    rdfs:comment "Whether authoring tools may connect two existing model elements using this relationship policy." ;
    rdfs:range xsd:boolean .

dafm:allowCreateSource
    a owl:DatatypeProperty ;
    rdfs:label "allow create source" ;
    rdfs:comment "Whether an authoring tool may create a new semantic source element while creating the relationship." ;
    rdfs:range xsd:boolean .

dafm:allowCreateTarget
    a owl:DatatypeProperty ;
    rdfs:label "allow create target" ;
    rdfs:comment "Whether an authoring tool may create a new semantic target element while creating the relationship." ;
    rdfs:range xsd:boolean .

dafm:disallowSelf
    a owl:DatatypeProperty ;
    rdfs:label "disallow self" ;
    rdfs:comment "Whether authoring tools should prevent connecting an element to itself through this relationship." ;
    rdfs:range xsd:boolean .

dafm:noInheritanceFromMetatype
    a owl:DatatypeProperty ;
    rdfs:label "no inheritance from metatype" ;
    rdfs:comment "Preserves the legacy QuickLink behavior that does not inherit choices from the underlying UML metatype." ;
    rdfs:range xsd:boolean .

dafm:authoringMenuGroup
    a owl:DatatypeProperty ;
    rdfs:label "authoring menu group" ;
    rdfs:comment "Logical authoring menu group; generated from the configured DAF profile name." ;
    rdfs:range xsd:string .

dafm:authoringComplexityLevel
    a owl:DatatypeProperty ;
    rdfs:label "authoring complexity level" ;
    rdfs:comment "Authoring complexity level preserved from the legacy QuickLink transformation." ;
    rdfs:range xsd:integer .

dafm:forwardAuthoringDirection
    a owl:DatatypeProperty ;
    rdfs:label "forward authoring direction" ;
    rdfs:comment "Direction token derived for source-to-target authoring; mirrors the legacy QuickLink transformation." ;
    rdfs:range xsd:string .

dafm:backwardAuthoringDirection
    a owl:DatatypeProperty ;
    rdfs:label "backward authoring direction" ;
    rdfs:comment "Direction token derived for target-to-source authoring; mirrors the legacy QuickLink transformation." ;
    rdfs:range xsd:string .

dafm:derivedQuickLinkRowCount
    a owl:DatatypeProperty ;
    rdfs:label "derived QuickLink row count" ;
    rdfs:comment "Number of legacy EA QuickLink rows deterministically derivable from this relationship authoring definition." ;
    rdfs:range xsd:integer .

dafm:packagePath
    a owl:DatatypeProperty ;
    rdfs:label "package path" ;
    rdfs:comment "Human-readable package path in the source M3 model." ;
    rdfs:range xsd:string .

dafm:isDerived
    a owl:DatatypeProperty ;
    rdfs:label "is derived" ;
    rdfs:comment "Indicates a derived property or relationship end." ;
    rdfs:range xsd:boolean .

dafm:tagName
    a owl:DatatypeProperty ;
    rdfs:label "tag name" ;
    rdfs:comment "Original tagged-value name." ;
    rdfs:range xsd:string .

