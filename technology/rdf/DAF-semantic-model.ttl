    dafm:packagePath "Delta Architectural Framework/DAF/Metamodel" ;
    skos:altLabel "dStakeholder" ;
    rdfs:comment "Represents any party or force influencing the domain of interest. Any person or force that have an interest in the considered domain. This is typically indicated by name, can be connected with a Role in the organization. A stakeholder has open and Inner opinions that are relevant for the subject matter.\n" ;
    dafm:umlMetaclass "Actor" .

daf:dStakeholder rdfs:subClassOf daf:DAFBase .

