# Concept: Network
daf:dNetwork
    a owl:Class, dafm:ConceptDefinition ;
    rdfs:label "Network" ;
    skos:notation "dNetwork" ;
    dafm:eaGuid "{7D83BF2A-1C8A-41ff-915D-F7A053418E5A}" ;
    dafm:definedInPackage dafpkg:Package_n_02BC7973 ;
    dafm:packagePath "Delta Architectural Framework/DAF/Metamodel" ;
    skos:altLabel "dNetwork" ;
    rdfs:comment "The main communication medium between services and deployments, mapped to ArchiMate Communication Networks, facilitating inter-service communication." ;
    dafm:umlMetaclass "Node" .

daf:dNetwork rdfs:subClassOf daf:DAFBase .

