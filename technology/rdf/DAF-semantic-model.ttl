daf:dBusinessService
    a owl:Class, dafm:ConceptDefinition ;
    rdfs:label "Business Service" ;
    skos:notation "dBusinessService" ;
    dafm:eaGuid "{2EFDC6BD-5D2A-468a-A930-8DD34A93C714}" ;
    dafm:definedInPackage dafpkg:Package_n_02BC7973 ;
    dafm:packagePath "Delta Architectural Framework/DAF/Metamodel" ;
    skos:altLabel "dBusinessService" ;
    rdfs:comment "<ol>\n\t<li>A repeatable activity; a discrete behavior that a building block may be requested or otherwise triggered to perform.</li>\n\t<li>A service provided by Business that achieve a business outcome in response to a request.</li>\n</ol>" ;
