    dafm:packagePath "Delta Architectural Framework/DAF/Metamodel" ;
    skos:altLabel "dDeploymentModel" ;
    rdfs:comment "The root class for the description of a Deployments to roll out an application, service, or container to a set of resources. akin to ArchiMate's Technology Layer deployment views." ;
