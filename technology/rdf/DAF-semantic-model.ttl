daf:dSubNetwork
    a owl:Class, dafm:ConceptDefinition ;
    rdfs:label "Sub Network" ;
    skos:notation "dSubNetwork" ;
    dafm:eaGuid "{B95CAEC8-FB5F-4584-9CCA-43B29649B8E3}" ;
    dafm:definedInPackage dafpkg:Package_n_02BC7973 ;
    dafm:packagePath "Delta Architectural Framework/DAF/Metamodel" ;
    skos:altLabel "dSubNetwork" ;
    rdfs:comment "A subset of a network, used to organize and isolate portions of the network. Equivalent to an ArchiMate Node, responsible for networking resources." ;
