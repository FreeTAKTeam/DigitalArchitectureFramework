    rdfs:label "supporting class count" ;
    rdfs:comment "Number of generated supporting M3 classes." ;
    rdfs:range xsd:integer .

dafm:registeredClassCount
    a owl:DatatypeProperty ;
    rdfs:label "registered M3 class count" ;
    rdfs:comment "Number of M3 classes registered during the generation pass." ;
    rdfs:range xsd:integer .

dafm:registeredRelationshipCount
    a owl:DatatypeProperty ;
    rdfs:label "registered M3 relationship count" ;
    rdfs:comment "Number of non-generalization M3 relationships registered during the generation pass." ;
    rdfs:range xsd:integer .

dafm:relationshipKindSource
    a owl:DatatypeProperty ;
    rdfs:label "relationship kind source" ;
    rdfs:comment "How the semantic relationship kind was determined: Metaclass, Redefines, or EAConnectorTypeFallback." ;
    rdfs:range xsd:string .

dafm:semanticFormat
    a owl:DatatypeProperty ;
    rdfs:label "semantic format" ;
    rdfs:comment "Additional format constraint for a primitive datatype, for example uuid." ;
    rdfs:range xsd:string .

dafm:synthetic
    a owl:DatatypeProperty ;
    rdfs:label "synthetic" ;
    rdfs:comment "Indicates a semantic definition introduced by the generator rather than explicitly present in the M3 source model." ;
    rdfs:range xsd:boolean .

dafm:explicitPrimitivePropertyCount
    a owl:DatatypeProperty ;
    rdfs:label "explicit primitive property count" ;
    rdfs:comment "Number of M3 attributes using an explicit supported UML2 primitive datatype." ;
    rdfs:range xsd:integer .

dafm:legacyConvertedPropertyCount
    a owl:DatatypeProperty ;
    rdfs:label "legacy converted property count" ;
    rdfs:comment "Number of legacy EA property types normalized during semantic export, such as Memo to xsd:string." ;
    rdfs:range xsd:integer .

dafm:booleanNamingConventionPropertyCount
    a owl:DatatypeProperty ;
    rdfs:label "Boolean naming-convention property count" ;
    rdfs:comment "Number of M3 properties semantically projected as Boolean because their name starts with is." ;
    rdfs:range xsd:integer .

dafm:suppressedDuplicateIdPropertyCount
    a owl:DatatypeProperty ;
    rdfs:label "suppressed duplicate ID property count" ;
    rdfs:comment "Number of class-level M3 attributes named exactly ID, Id or id that were intentionally omitted because semantic identity is inherited from DAFBase." ;
    rdfs:range xsd:integer .

dafm:classifierTypedPropertyCount
    a owl:DatatypeProperty ;
    rdfs:label "classifier typed property count" ;
    rdfs:comment "Number of M3 attributes whose datatype is resolved through a classifier." ;
    rdfs:range xsd:integer .

dafm:unresolvedPropertyTypeCount
    a owl:DatatypeProperty ;
    rdfs:label "unresolved property type count" ;
    rdfs:comment "Number of M3 attributes with <none> or empty type and no classifier." ;
    rdfs:range xsd:integer .

dafm:unknownPropertyTypeCount
    a owl:DatatypeProperty ;
    rdfs:label "unknown property type count" ;
    rdfs:comment "Number of M3 attributes with unsupported textual datatype names." ;
    rdfs:range xsd:integer .

dafm:dafBaseInheritanceCount
    a owl:DatatypeProperty ;
    rdfs:label "DAFBase inheritance count" ;
    rdfs:comment "Number of M3 classes to which synthetic DAFBase inheritance was added." ;
    rdfs:range xsd:integer .

dafm:authoringEnabledRelationshipCount
    a owl:DatatypeProperty ;
    rdfs:label "authoring-enabled relationship count" ;
    rdfs:comment "Number of M3 relationship definitions from which authoring semantics were derived." ;
    rdfs:range xsd:integer .

dafm:derivedQuickLinkEquivalentRuleCount
    a owl:DatatypeProperty ;
    rdfs:label "derived QuickLink equivalent rule count" ;
    rdfs:comment "Number of EA QuickLink rules that the semantic authoring definitions would deterministically generate." ;
    rdfs:range xsd:integer .

dafm:legacyProfileConceptCount
    a owl:DatatypeProperty ;
    rdfs:label "legacy profile concept count" ;
    rdfs:comment "Number of legacy profile element mappings found during audit." ;
    rdfs:range xsd:integer .

dafm:legacyProfileRelationshipCount
    a owl:DatatypeProperty ;
    rdfs:label "legacy profile relationship count" ;
    rdfs:comment "Number of legacy relationship profile mappings found during audit." ;
    rdfs:range xsd:integer .

dafm:quickLinkRuleCount
    a owl:DatatypeProperty ;
    rdfs:label "legacy QuickLink rule count" ;
    rdfs:comment "Number of active rows found in the configured legacy QuickLink CSV during audit." ;
    rdfs:range xsd:integer .

# Datatype-resolution status values
dafm:ExplicitPrimitiveType a dafm:TypingStatus ; rdfs:label "Explicit UML2 primitive type" .
dafm:LegacyTypeConversion a dafm:TypingStatus ; rdfs:label "Legacy source type converted to semantic datatype" .
dafm:BooleanNamingConventionType a dafm:TypingStatus ; rdfs:label "Boolean type inferred from is* property naming convention" .
dafm:ClassifierType a dafm:TypingStatus ; rdfs:label "Classifier-resolved type" .
dafm:EnumerationType a dafm:TypingStatus ; rdfs:label "Enumeration type" .
dafm:UnresolvedType a dafm:TypingStatus ; rdfs:label "Unresolved type" .
dafm:UnknownType a dafm:TypingStatus ; rdfs:label "Unknown textual type" .

# ---------------------------------------------------------------------
# Common DAF ModelElement metadata
# ---------------------------------------------------------------------

daf:DAFBase
    a owl:Class ;
    rdfs:label "DAF Base" ;
    rdfs:comment "Synthetic common superclass for all DAF M3 classes. It carries the vendor-neutral properties previously represented by the OpenAPI DAFBase schema." ;
    rdfs:subClassOf dafm:ModelElement ;
    dafm:synthetic true .

dafp:id
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Identifier" ;
    rdfs:comment "Stable UUID identifier of a DAF model element." ;
    dafm:semanticFormat "uuid" .

dafp:name
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment "Human-readable name of a model element." .

dafp:alias
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Alias" ;
    rdfs:comment "Optional alternate name." .

dafp:notes
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Notes" ;
    rdfs:comment "Human-readable documentation." .

dafp:status
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Status" ;
    rdfs:comment "Lifecycle or governance status." .

dafp:version
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Version" ;
    rdfs:comment "Version associated with the model element." .

dafp:phase
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Phase" ;
    rdfs:comment "Lifecycle or project phase." .

dafp:author
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Author" ;
    rdfs:comment "Author responsible for the model element." .

dafp:createdBy
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Created by" ;
    rdfs:comment "Identity of the user, system or agent that created the model element." .

dafp:modifiedBy
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Modified by" ;
    rdfs:comment "Identity of the user, system or agent that most recently modified the model element." .

dafp:createdAt
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:dateTime ;
    rdfs:label "Created at" ;
    rdfs:comment "Creation timestamp." .

dafp:modifiedAt
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:dateTime ;
    rdfs:label "Modified at" ;
    rdfs:comment "Last-modified timestamp." .

dafp:visibility
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Visibility" ;
    rdfs:comment "Visibility such as Public, Private, Protected or Package." .

dafp:modelType
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Model type" ;
    rdfs:comment "Underlying modeling type such as Class, Component, Actor or Requirement." .

dafp:stereotype
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Stereotype" ;
    rdfs:comment "Applied modeling stereotype." .

dafp:keywords
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Keywords" ;
    rdfs:comment "Keywords associated with the model element." .

dafp:complexity
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Complexity" ;
    rdfs:comment "Modeling or implementation complexity." .

dafp:multiplicity
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Multiplicity" ;
    rdfs:comment "Multiplicity associated with the model element." .

dafp:persistence
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Persistence" ;
    rdfs:comment "Persistence classification such as Persistent or Transient." .

dafp:priority
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Priority" ;
    rdfs:comment "Priority where applicable." .

dafp:language
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:string ;
    rdfs:label "Language" ;
    rdfs:comment "Implementation or specification language where applicable." .

dafp:isAbstract
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:boolean ;
    rdfs:label "Is abstract" ;
    rdfs:comment "Whether the model element is abstract." .

dafp:isLeaf
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:boolean ;
    rdfs:label "Is leaf" ;
    rdfs:comment "Whether the model element is final/leaf." .

dafp:isRoot
    a owl:DatatypeProperty ;
    rdfs:domain daf:DAFBase ;
    rdfs:range xsd:boolean ;
    rdfs:label "Is root" ;
    rdfs:comment "Whether the model element is a root." .

dafp:package
    a owl:ObjectProperty ;
    rdfs:label "package" ;
    rdfs:comment "Package containing the model element." .

dafp:parent
    a owl:ObjectProperty ;
    rdfs:label "parent" ;
    rdfs:comment "Parent model element." .


# ---------------------------------------------------------------------
# Common SHACL constraints
# ---------------------------------------------------------------------

dafshape:ModelElementShape
    a sh:NodeShape ;
    sh:targetClass dafm:ModelElement .

dafshape:DAFBaseShape
    a sh:NodeShape ;
    sh:targetClass daf:DAFBase ;
    sh:node dafshape:ModelElementShape ;
    sh:property [
        sh:path dafp:id ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path dafp:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path dafp:createdBy ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path dafp:modifiedBy ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] ;
    sh:property [ sh:path dafp:createdAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path dafp:modifiedAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] .

dafshape:RelationshipShape
    a sh:NodeShape ;
    sh:targetClass dafm:Relationship ;
    sh:property [ sh:path dafm:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:class dafm:ModelElement ] ;
    sh:property [ sh:path dafm:target ; sh:minCount 1 ; sh:maxCount 1 ; sh:class dafm:ModelElement ] .

# ---------------------------------------------------------------------
# Relationship authoring policy
# Derived from the legacy M3 Generate UML Profile.updateQuickLink logic.
# QuickLink.csv is treated only as a downstream compatibility/audit artifact.
# ---------------------------------------------------------------------

dafm:DefaultRelationshipAuthoringPolicy
    a dafm:AuthoringPolicy ;
    rdfs:label "Default DAF relationship authoring policy" ;
    rdfs:comment "Allows connection of existing elements and creation of either endpoint while creating the relationship. This is the platform-independent authoring policy from which the legacy EA QuickLink rows are derived." ;
    dafm:allowConnectExisting true ;
    dafm:allowCreateSource true ;
    dafm:allowCreateTarget true ;
    dafm:disallowSelf true ;
    dafm:noInheritanceFromMetatype true ;
    dafm:authoringMenuGroup "DAF" ;
    dafm:authoringComplexityLevel 0 .

