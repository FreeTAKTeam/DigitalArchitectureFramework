    rdfs:range xsd:string .

dafm:defaultValue
    a owl:DatatypeProperty ;
    rdfs:label "default value" ;
    rdfs:comment "Default value preserved from the M3 definition." ;
    rdfs:range xsd:string .

dafm:endKind
    a owl:DatatypeProperty ;
    rdfs:label "end kind" ;
