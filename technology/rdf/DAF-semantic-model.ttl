# Concept: Value Stream
daf:dValueStream
    a owl:Class, dafm:ConceptDefinition ;
    rdfs:label "Value Stream" ;
    skos:notation "dValueStream" ;
    dafm:eaGuid "{62DF78B4-19F0-4db7-8C01-6A704D8616B2}" ;
    dafm:definedInPackage dafpkg:Package_n_02BC7973 ;
    dafm:packagePath "Delta Architectural Framework/DAF/Metamodel" ;
    skos:altLabel "dValueStream" ;
    rdfs:comment "A representation of  an end-to end collection  of value-adding  Business Processes that create an overall result for a customer, stakeholder or end user. \nA sequence of activities an enterprise undertakes to deliver on a customer request. More broadly, the sequence of activities required to design, produce, and deliver a good or service to a customer, and it includes the dual flows of information and material." ;
    dafm:umlMetaclass "Activity" .

daf:dValueStream rdfs:subClassOf daf:DAFBase .

