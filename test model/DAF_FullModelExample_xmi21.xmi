rity" value="50#NOTES#Default: 50&#xA;Description: A priority in %&#xA;" modelElement="EAID_468F4DAE_D273_4cf6_BB6D_EA2F1A8DEB93"/><tag xmi:id="EAID_BAAFD270_F8AA_19f8_82C0_5138008DAF19" name="Value_amount" value="#NOTES#Description: The actual amount of the value this goal intends to alter&#xA;" modelElement="EAID_468F4DAE_D273_4cf6_BB6D_EA2F1A8DEB93"/><tag xmi:id="EAID_CCB3C93F_8CD9_f98c_8D4E_0EC4CB7F7AEB" name="Value_Goal" value="#NOTES#Description: The amount by which the value is to be altered&#xA;" modelElement="EAID_468F4DAE_D273_4cf6_BB6D_EA2F1A8DEB93"/><tag xmi:id="EAID_CCB765DD_2977_fd29_A64A_056FDD179950" name="Value_Name" value="#NOTES#Description: The name of the value this goal intends to alter&#xA;" modelElement="EAID_468F4DAE_D273_4cf6_BB6D_EA2F1A8DEB93"/></tags><xrefs value="$XREFPROP=$XID={6F508451-6B50-4432-8187-017889EAAE22}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=dGoal;FQName=DAF::dGoal;@ENDSTEREO;$DES;$CLT={468F4DAE-D273-4cf6-BB6D-EA2F1A8DEB93}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/><extendedProperties tagged="0" package_name="DAF reference instance"/><links><Aggregation xmi:id="EAID_D002BDAE_D082_4e4e_AF15_F0E8CFC420CD" start="EAID_11927058_A062_44d6_8885_6BAFE7A2D269" end="EAID_468F4DAE_D273_4cf6_BB6D_EA2F1A8DEB93"/></links></element><element xmi:idref="EAID_5547316E_0587_4d8b_BFB4_216DEC49095F" xmi:type="uml:Class" name="IP Range" scope="public"><model package="EAPK_FD22FC53_67E7_4787_A478_330193BE9783" tpos="0" ea_localid="28243" ea_eleType="element"/><properties isSpecification="false" sType="Class" nType="0" scope="public" stereotype="dIPRange" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/><project author="Corvo" version="24.0.0" phase="24.5" created="2024-09-16 13:33:03" modified="2025-08-14 10:45:20" complexity="1" status="Proposed"/><code gentype="Java"/><style appearance="BackColor=-1;BorderColor=-1;BorderWidth=1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/><tags><tag xmi:id="EAID_00381582_71BF_9971_8ADF_E1D3474ED76D" name="CIDR" value="#NOTES#Description: The term CIDR (Classless Inter-Domain Routing) range refers to an IP address range that is defined by a combination of an IP address and a routing prefix (or subnet mask). CIDR notation is used to specify IP address ranges in a compact format, which is widely used in network configuration, including the configuration of cloud resources, subnets, or containers.&#xA;&#xA;CIDR range is written as an IP address followed by a slash (&quot;/&quot;) and a number. For example, 192.168.0.0/24 refers to an IP range where the first 24 bits are network bits, and the remaining bits (in this case, 8 bits) are used for defining host addresses. This notation helps specify networks of varying sizes and allows more flexible allocation of IP addresses compared to the traditional class-based method.&#xA;" modelElement="EAID_5547316E_0587_4d8b_BFB4_216DEC49095F"/><tag xmi:id="EAID_E7309DE8_0FC5_b40f_9EFB_9CB55C8E88B3" name="ipRangeType" value="#NOTES#Values: subNetwork,Pod,Service&#xA;" modelElement="EAID_5547316E_0587_4d8b_BFB4_216DEC49095F"/><tag xmi:id="EAID_0DBE8FDF_13BC_3d13_8742_2372C87BF4D8" name="Public" value="#NOTES#Values: true,false&#xA;" modelElement="EAID_5547316E_0587_4d8b_BFB4_216DEC49095F"/></tags><xrefs value="$XREFPROP=$XID={37CD888A-2537-4bf9-A736-754966519D45}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=dIPRange;FQName=DAF::dIPRange;@ENDSTEREO;$DES;$CLT={5547316E-0587-4d8b-BFB4-216DEC49095F}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/><extendedProperties tagged="0" package_name="DAF reference instance"/><links><Aggregation xmi:id="EAID_E541379C_6CFE_40bb_8484_26CAA0FB09E2" start="EAID_5547316E_0587_4d8b_BFB4_216DEC49095F" end="EAID_10E1E649_299F_45e5_AF21_48A46AD2FBB7"/></links></element><element xmi:idref="EAID_A65C12CD_A8A7_4aa4_B17A_E9F4AD5B53DF" xmi:type="uml:Class" name="Issue" scope="public"><model package=