g the documentation is to be used (including the port). The host does not support path templating.&#xA;" modelElement="EAID_B539EC35_0FE1_4074_A165_D7BEA235A45E"/><tag xmi:id="EAID_00000DED_59BE_2059_8935_8E093236B10E" name="ID" modelElement="EAID_B539EC35_0FE1_4074_A165_D7BEA235A45E"/><tag xmi:id="EAID_75B80AC3_0D74_320d_AB06_63E00B134E9E" name="license" value="EPL#NOTES#Default: EPL&#xA;" modelElement="EAID_B539EC35_0FE1_4074_A165_D7BEA235A45E"/><tag xmi:id="EAID_4D8F7154_4265_4342_8F43_B404D8BC476C" name="parameters" modelElement="EAID_B539EC35_0FE1_4074_A165_D7BEA235A45E"/><tag xmi:id="EAID_AE7C3B85_9456_3694_B577_0959C570DF00" name="produces" value="application/json#NOTES#Values: text/plain&amp;_sc_^ charset&amp;_eq_^utf-8,application/json,application/vnd.github+json,application/vnd.github.v3+json,application/vnd.github.v3.raw+json,application/vnd.github.v3.text+json,application/vnd.github.v3.html+json,application/vnd.github.v3.full+json,application/vnd.github.v3.diff,application/vnd.github.v3.patch&#xA;Default: application/json&#xA;" modelElement="EAID_B539EC35_0FE1_4074_A165_D7BEA235A45E"/><tag xmi:id="EAID_B72548A2_BB93_2abb_A2FF_841A9831AD6E" name="responses" modelElement="EAID_B539EC35_0FE1_4074_A165_D7BEA235A45E"/><tag xmi:id="EAID_82EB34C8_3779_6537_818A_97745F5F18C7" name="schemes" value="#NOTES#Description: The transfer protocol of the API.&#xA;" modelElement="EAID_B539EC35_0FE1_4074_A165_D7BEA235A45E"/><tag xmi:id="EAID_EE7BD0D4_BCE5_27bc_85D1_80CB2CCBFDB1" name="securityDefinitions" modelElement="EAID_B539EC35_0FE1_4074_A165_D7BEA235A45E"/><tag xmi:id="EAID_B114B510_B7C1_8eb7_9C0A_C8FF314E033E" name="swagger" value="3.0.1#NOTES#Default: 3.0.1&#xA;Description: OpenApi version&#xA;Specifies the Swagger Specification version being used. It can be used by the Swagger UI and other clients to interpret the API listing. The value MUST be &quot;2.0&quot;.&#xA;" modelElement="EAID_B539EC35_0FE1_4074_A165_D7BEA235A45E"/><tag xmi:id="EAID_0041464F_DEA0_b5de_87B