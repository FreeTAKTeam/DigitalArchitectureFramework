_Package" visibility="public"><packagedElement xmi:type="uml:PrimitiveType" xmi:id="EAJava_boolean" name="boolean" visibility="public"><generalization xmi:type="uml:Generalization" xmi:id="EAJava_boolean_General"><general href="http://schema.omg.org/spec/UML/2.1/uml.xml#Boolean"/></generalization></packagedElement><packagedElement xmi:type="uml:PrimitiveType" xmi:id="EAJava_int" name="int" visibility="public"><generalization xmi:type="uml:Generalization" xmi:id="EAJava_int_General"><general href="http://schema.omg.org/spec/UML/2.1/uml.xml#Integer"/></generalization></packagedElement></packagedElement></packagedElement></primitivetypes><profiles><uml:Profile xmlns:uml="http://schema.omg.org/spec/UML/2.1/" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmi:version="2.1" xmi:id="B91435BE-4" nsPrefix="DAF" name="DAF" metamodelReference="mmref01"><ownedComment xmi:type="uml:Comment" xmi:id="comment01" annotatedElement="B91435BE-4"><body>Initial version created on 13-Jan-2016.  Added all shapes.  Added Icons.  Modified Delta to Lowercase (S type symbol) from Upper case (triangle)  3.0.0.M: Added diagram and remaining toolbox profiles.  3.0.0.N: Added all the quick linker for component creation.  3.0.0.O - Added quick linker for existing components and modified icons.  3.0.0.P - updated with views and tool boxes.  3.0.0.Q - updated with Default size and colors 3.0.0.R - Added table, model and physical service and quick linker for the components.  3.0.0.S - Added modified icons and represented them on top right corner. Changed component default representation to custom representation.  3.0.0.T-Updated Quick Linker with self composition to the elements. Linked Value and ValueRef to Class and added it to the MDG Profile.  3.0.0.U - Added scripts for generation of controller class for the use case from package and diagram.  3.0.0.V - removed some types (in rejected package), added missing types and tagged values (User Story, dDeploymentNode, dProgram) 3.0.0.W - Changed the background and foreground color for Business Partner Active to check the output.  3.1 - new revamped 2018 version updated to Sparx 14 3.1.3 added Event 3.2 Updated for EA 14.1 3.3 update to comply with TOGAF 9.2 3.3.8 fixed quicklinker, diagrams 3.3.9 added Application Investment disposition 3.3.12 added KPI tagged value 3.3.15 Added Dots for evaluation 3.4 added masked types for tagged values 3.4.2 consolidated actors, shape script  3.4.5 consolidated colors 3.4.10 shape script functions 3.5 adding additional shape script functions 4.0 Alpha 2 changed based class for dOrganization (actor don't support icon shape???) 4.0 Alpha 3 added diagram patterns 4.0 Beta quicklink generated with M3 and fixed Version:6.0 BETA 7</body></ownedComment><packageImport xmi:id="mmref01"><importedPackage href="http://schema.omg.org/spec/UML/2.1/"/></packageImport><packagedElement xmi:type="uml:Stereotype" xmi:id="dSubNetwork" name="dSubNetwork"><ownedAttribute xmi:type="uml:Property" xmi:id="dSubNetwork-base_Class" name="base_Class" association="Class_dSubNetwork"><type href="http://schema.omg.org/spec/UML/2.1/Class"/></ownedAttribute></packagedElement><packagedElement xmi:type="uml:Extension" xmi:id="Class_dSubNetwork" name="A_Class_dSubNetwork" memberEnd="extension_dSubNetwork dSubNetwork-base_Class"><ownedEnd xmi:type="uml:ExtensionEnd" xmi:id="extension_dSubNetwork" name="extension_dSubNetwork" type="dSubNetwork" isComposite="true" lower="0" upper="1" memberEnd="extension_dSubNetwork dSubNetwork-base_Class"/></packagedElement><packagedElement xmi:type="uml:Stereotype" xmi:id="dGoalhasObjective" name="dGoalhasObjective"><ownedAttribute xmi:type="uml:Property" xmi:id="dGoalhasObjective-base_Aggregation" name="base_Aggregation" association="Aggregation_dGoalhasObjective"><type href="http://schema.omg.org/spec/UML/2.1/Aggregation"/></ownedAttribute></packagedElement><packagedElement xmi:type="uml:Extension" xmi:id="Aggregation_dGoalhasObjective" name="A_Aggregation_dGoalhasObjective" memb