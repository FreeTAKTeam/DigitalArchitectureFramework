rty$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=dApplicationComponent;FQName=DAF::dApplicationComponent;@ENDSTEREO;$DES;$CLT={B93BA1CB-CDDF-484b-9659-7B89E9D34C11}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/><extendedProperties tagged="0" package_name="example XMI"/><links><Assembly xmi:id="EAID_7D3D10D9_D687_4756_9BB1_1BABB7F29B37" start="EAID_299F1355_45D0_42a1_A373_2A15620A33F7" end="EAID_B93BA1CB_CDDF_484b_9659_7B89E9D34C11"/></links></element><element xmi:idref="EAID_BD69836E_F142_40f5_8A5E_56653815DD9A" xmi:type="uml:Component" name="NISE" scope="public"><model package="EAPK_1F137375_A120_4eb0_BB2C_3CB48030145F" tpos="0" ea_localid="28405" ea_eleType="element"/><properties documentation="NISE (Network Inventory and Service Environment) - NISE-CORE is the equipment inventory, ordering and facility design portion of NISE-CORE serviced. Its function is to receive and inventory both optical and electrical equipment inventory. Further it interfaces with the Intelligent Network Elements in the network to maintain current status. Facility &#xA;&#xA;provisioning is supported by multiple automated processes as well as providing multiple user interfaces for manual facility designs. It also interfaces with TSNOW-OIP to provide provisioning documents and to receive In-Effect notes. It does work steps, and automatically makes requests to other systems, such as auto provisioning requests to OneVu, for orders that those systems can work without manual intervention. " isSpecification="false" sType="Component" nType="0" alias="Network Inventory and Service Environment" scope="public" stereotype="dApplicationComponent" isRoot="false" isLeaf="false" isAbstract="false"/><project author="Giuseppe Platania" version="25.05.01" phase="Artemis" created="2025-05-06 12:34:55" modified="2025-08-14 17:17:18" complexity="1" status="Proposed"/><code gentype="Java"/><style appearance="BackColor=-1;BorderColor=-1;BorderWidth=1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/><tags><tag 