shape main
{
	layoutType="border";
	defsize(140,80);
	rectangle(0,0,100,100);
	addsubshape("header","n");
	addsubshape("name","center");

	// calendar band showing which period the results cover
	shape header
	{
		// properties must precede drawing commands
		preferredheight=20;
		h_align="left";
		v_align="center";
		setpencolor(79,129,189); // Daf blue
		setfillcolor(79,129,189);
		rectangle(0,0,100,100);
		setfontcolor(255,255,255);
		print(" #TAG:periodStart#  #TAG:periodLength#");
	}

	shape name
	{
		h_align="center";
		v_align="center";
		if(hasproperty("stereotypehidden","false"))
		{
			println("<<#stereotype#>>");
		}
		println("#NAME#");
	}
}

// results of the period: revenue, costs and result, on a baseline
decoration results
{
	orientation="SE";
	setpencolor(67,174,119); // Daf green: revenue
	setfillcolor(67,174,119);
	rectangle(5,10,30,85);
	setpencolor(186,117,23); // orange: costs
	setfillcolor(186,117,23);
	rectangle(37,35,62,85);
	setpencolor(24,95,165); // dark blue: result
	setfillcolor(24,95,165);
	rectangle(69,55,94,85);
	setpencolor(127,127,127);
	moveto(0,90);
	lineto(100,90);
}
