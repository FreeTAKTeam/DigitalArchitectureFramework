shape main
{
	layoutType="border";
	defsize(140,80);
	rectangle(0,0,100,100);
	addsubshape("header","n");
	addsubshape("name","center");

	// calendar band showing which period the revenue covers
	shape header
	{
		// properties must precede drawing commands
		preferredheight=20;
		h_align="left";
		v_align="center";
		setpencolor(79,129,189); // Daf blue
		setfillcolor(79,129,189);
		rectangle(0,0,100,100);
		setfontcolor(255,255,255);
		print(" #TAG:periodStart#  #TAG:periodLength#");
	}

	shape name
	{
		h_align="center";
		v_align="center";
		if(hasproperty("stereotypehidden","false"))
		{
			println("<<#stereotype#>>");
		}
		println("#NAME#");
	}
}

// money coming in: a rising arrow
decoration income
{
	orientation="SE";
	setpenwidth(2);
	setpencolor(67,174,119); // Daf green
	setfillcolor(67,174,119);
	moveto(10,90);
	lineto(80,20);
	startpath();
	moveto(50,15);
	lineto(90,10);
	lineto(85,50);
	endpath();
	fillandstrokepath();
}
